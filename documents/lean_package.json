    "docs/guides/cli-reference.json",
    "docs/guides/manifest.json",
    "docs/guides/operator-guide.en.md",
    "docs/guides/technical-guide.en.md",
    "docs/guides/user-guide.de.md",
    "docs/guides/user-guide.en.md",
    "docs/integration-status.md",
    "documents/QUICKSTART.md",
    "documents/REVIEW_CORE.md",
    "documents/lean_package.json",
    "examples/README.md",
    "examples/brief.md",
    "examples/document_review_todo.md",
    "examples/lean_todo.md",
    "examples/minimal_todo.md",
    "examples/planning_todo.md",
    "examples/python_function_todo.md",
    "execution_budget.py",
    "git_publication_cli.py",
