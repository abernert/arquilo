  "retained_core_options": {
    "parallel": "CFG parallel with real Python workers in separate subworkspaces",
    "runtime_profiles": "--runtime-profile / ARQUILO_RUNTIME_PROFILE with the documented boundaries",
    "git": "--git with literal --git-path selections; --git-push separately opts into publishing; default off",
    "prompt_config": "--prompt-config default|de|en|FILE; immutable catalog snapshot per run"
  },
  "excluded_data": [
    "audit/**",
    ".git/**",
    ".github/**",
    ".venv/**",
    "dist/**",
    ".codex_runs/**",
    "documents/history/**",
    "documents/lean_build/**",
    "documents/todos/**",
    "tests/**",
    ".arquilo_runs/**"
  ],
  "project": "ARQUILO",
  "license": "Apache-2.0"
}
