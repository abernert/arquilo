{
  "schema_version": "arquilo.lean.package.v1",
  "python_requires": ">=3.11",
  "runtime_dependencies": [],
  "build_dependencies": [],
  "runtime_file_count": 90,
  "external_runtime": {
    "codex_cli": "Codex CLI with the required Exec contract; verify using arquilo_doctor.py --check-decide (one model call, may incur costs); no version pin",
    "git": "Only for explicitly enabled --git functions",
    "node": "Only when using a supported npm launcher (Codex or Claude Code)",
    "claude_code_cli": "Optional instead of Codex with --backend claude-code; native print/stream-json contract and safety options checked by doctor. No Codex installation/authentication required."
  },
  "runtime_files": [
    ".gitignore",
    "AUTHORS.md",
    "CHANGELOG.md",
    "CITATION.cff",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "NOTICE",
    "README.de.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY.md",
    "VERSION",
    "agent_backend.py",
    "agent_process.py",
    "agent_types.py",
    "arquilo.py",
    "arquilo_doctor.py",
    "autobuild.py",
    "autobuild_contract.py",
    "claude_decision.py",
    "claude_doctor.py",
    "claude_launcher.py",
    "claude_transport.py",
    "codex_launcher.py",
    "codex_policy.py",
    "codex_transport.py",
    "config/policy.md",
    "controller_state.py",
    "decide.py",
    "decision_archive.py",
    "decision_exec.py",
    "decision_request.py",
    "decision_response.py",
    "docs/README.md",
